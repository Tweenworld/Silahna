# Copy to .env and fill. The app refuses to start if any required value is blank
# or a known placeholder. Synthetic data only.

# Security & Encryption Keys (min 16 chars, no placeholders)
AUDIT_KEY=
SESSION_SECRET=
GENOTYPE_KEY=

# Application Runtime Database Connection
# Connects as least-privilege role app_rw (no CREATE, no TEMP, no superuser, no BYPASSRLS)
DATABASE_URL=postgresql://app_rw:app_rw_secret@localhost:5432/silahna

# Database Migrations Connection (Alembic)
# Must run as the dedicated schema and table owner role (silahna_definer), NOT as superuser
MIGRATION_DATABASE_URL=postgresql://silahna_definer:silahna_definer_secret@localhost:5432/silahna

# Initial Cluster Bootstrapping Only (for initial database & role provisioning; never used at runtime)
# BOOTSTRAP_SUPERUSER_URL=postgresql://postgres:postgres_admin_password@localhost:5432/postgres

DEMO_MODE=0
RULESET_VERSION=0.1.0
AUDIT_HEAD_PATH=var/audit-head.log
