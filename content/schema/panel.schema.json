{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PanelSchema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "genes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "disease": {
            "type": "string",
            "minLength": 1
          },
          "inheritance": {
            "type": "string",
            "enum": ["autosomal_recessive", "autosomal_dominant", "x_linked", "unknown"]
          },
          "minimum_review_status": {
            "type": "string",
            "minLength": 1
          },
          "validity": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["symbol", "disease", "inheritance", "minimum_review_status", "validity"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "genes"],
  "additionalProperties": false
}
