{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RulePackManifest",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved"]
    },
    "reviewed_by": {
      "type": ["string", "null"]
    },
    "reviewed_on": {
      "type": ["string", "null"]
    }
  },
  "required": ["version", "engine_version", "status"],
  "additionalProperties": false
}
